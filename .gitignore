# ==========================================
# Unity Standard .gitignore
# ==========================================

# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
# /[Bb]uild/  (Habilitado para permitir la subida del build ejecutable)
# /[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Builds and packages
*.apk
*.aab
*.unitypackage
*.app

# Visual Studio / Visual Studio Code / Rider
.vscode/
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# OS Generated
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.log.txt
*.tmp
